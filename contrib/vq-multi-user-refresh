mv -- "$stage" "$OPT_VENV"
fsync_dir "$OPT_ROOT"
[ "$(stat -c '%d:%i' "$OPT_VENV")" = "$stage_dev:$stage_ino" ] \
    || die "new target does not contain the receipt-bound staged inode"
update_receipt "$transaction" "target-created"
/usr/bin/env -i HOME=/root PATH=/usr/bin:/bin PYTHONNOUSERSITE=1 \
    "$LOCK_PYTHON" -I -m venv "$OPT_VENV"
/usr/bin/env -i HOME=/root PATH=/usr/bin:/bin PYTHONNOUSERSITE=1 \
    "$OPT_VENV/bin/pip" install --disable-pip-version-check --no-cache-dir \
    --no-index --no-deps "$wheelhouse"/*.whl
/usr/bin/env -i HOME=/root PATH=/usr/bin:/bin PYTHONNOUSERSITE=1 \
    "$OPT_VENV/bin/python" -I - <<'PY_VERIFY_RUNTIME_DISTS'
import importlib.metadata

expected = {
    "annotated-types": "0.8.0",
    "click": "8.4.2",
    "pydantic": "2.13.4",
    "pydantic-core": "2.46.4",
    "typing-extensions": "4.16.0",
    "typing-inspection": "0.4.4",
}
actual = {name: importlib.metadata.version(name) for name in expected}
if actual != expected:
    raise SystemExit(f"installed privileged runtime dependencies differ: {actual}")
PY_VERIFY_RUNTIME_DISTS

installed_tree="$("$OPT_VQ" source-tree-sha256)" \
    || die "new installed package cannot be digested"
[[ "$installed_tree" =~ ^[0-9a-f]{64}$ ]] || die "new package digest is malformed"
[ "$installed_tree" = "$expected_tree" ] \
    || die "installed vq tree $installed_tree differs from accepted commit tree $expected_tree"
/usr/bin/env -i HOME=/root PATH=/usr/bin:/bin PYTHONNOUSERSITE=1 \
