current_wheelhouse_sha="$(PYTHONNOUSERSITE=1 "$LOCK_PYTHON" -I -S - "$wheelhouse" <<'PY'
import hashlib
import pathlib
import sys
h = hashlib.sha256()
for path in sorted(pathlib.Path(sys.argv[1]).glob("*.whl"), key=lambda p: p.name):
    h.update(path.name.encode())
    h.update(b"\0")
    h.update(hashlib.sha256(path.read_bytes()).digest())
print(h.hexdigest())
PY
)"
[ "$current_wheelhouse_sha" = "$wheelhouse_sha" ] \
