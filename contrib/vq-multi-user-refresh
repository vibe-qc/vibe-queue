update_receipt "$transaction" "installing"
update_receipt "$transaction" "stage-pending"
mkdir -m 0755 -- "$stage"
fsync_dir "$stage"
fsync_dir "$OPT_ROOT"
stage_identity="$(stat -c '%d:%i' "$stage")"
stage_dev="${stage_identity%%:*}"
stage_ino="${stage_identity##*:}"
update_receipt "$transaction" "staged" "" "$stage_dev" "$stage_ino"
[ ! -e "$OPT_VENV" ] && [ ! -L "$OPT_VENV" ] \
