rpc_proof "$expected_sha" "$installed_tree" \
    || die "$UNIT failed exact post-activation RPC proof"

# Commit is durable before backup cleanup. Recovery of a committed receipt
# keeps the proved new install; every earlier phase restores the exact old one.
verify_unit_contract || die "unit contract changed after RPC proof"
rpc_proof "$expected_sha" "$installed_tree" \
    || die "$UNIT changed before the durable commit boundary"
update_receipt "$transaction" "committed" "$installed_tree"
if [ -e "$backup" ] || [ -L "$backup" ]; then
    [ "$(stat -c '%d:%i' "$backup")" \
        = "${RECEIPT_FIELDS[11]}:${RECEIPT_FIELDS[12]}" ] \
        || die "receipt-bound backup changed before commit cleanup"
